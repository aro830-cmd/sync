# Copy this file to .env.local and fill in the values, then restart `npm run dev`.
# .env.local is git-ignored — never commit real keys. Ask the repo owner for shared values over a private channel.

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Default gemini-3.8-flash; falls back to gemini-3.6-flash / 3.5-flash when busy.
GEMINI_MODEL=gemini-3.8-flash

# Supabase → Project Settings → API keys (use the SECRET key, sb_secret_…)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail → Google Account → Security → 2-Step Verification ON → App passwords → create one (16 letters, no spaces)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Organiser desk passcode (/admin/login). Use something long outside local demos.
ADMIN_PASSCODE=

# Signs login cookies. Any long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=
